# ── 构建 / 打包产物 ──
dist/
# 仓库根直接 `go build` 产生的二进制
/astro-mountain
*.exe *.exe~ *.dll *.so *.dylib
*.test
*.out

# 运行产物（Markdown / CSV / JSON 报告、抖音竖图）
reports/

# 磁盘缓存（SQLite 落盘）
.cache_astro/
.cache_astro.sqlite*
legacy/.cache_astro.sqlite*

# 一次性探针遗留库（开发期排障用）
.pytest_cache_probe.sqlite

# parity 回放模式录制的原始响应（本地生成）
.parity_records/

# requests_cache 的 SQLite 副文件（WAL / 共享内存）
requests_cache*.sqlite-wal
requests_cache*.sqlite-shm

# Python 字节码缓存（legacy/ 下的对照实现运行时产生）
__pycache__/
*.py[cod]

# 旧 Python 对照实现（开发期参照，非 Go 工程一部分，勿提交）
legacy/

# 派生配置：configs/ 是唯一真相源，internal/config/defaults/ 由
# build.sh 或 `go generate ./internal/config` 重新生成，勿提交（避免与 configs/ 漂移）
internal/config/defaults/*.json

# macOS 元数据
.DS_Store

# 本地配置（可能含 API 密钥，勿提交；用 config.example.json 作模板，或 --init-config 生成）
configs/config.json

# 编辑器 / 系统
.idea/
.vscode/
*.swp
*~
*.log

# Go vendor（本项目未启用，留作防御）
vendor/

# WorkBuddy 运行时记忆（含本地排障笔记，勿提交）
.workbuddy/
